# Apache / cPanel static hosting config.
# Copy this file next to index.html (i.e. into the root of the uploaded site).
# Works at a domain root or in a subdirectory.

# Correct MIME types for the WebAssembly and worker payloads
<IfModule mod_mime.c>
  AddType application/wasm .wasm
  AddType application/manifest+json .webmanifest
  AddType application/javascript .mjs .js
  AddType application/octet-stream .data .sf2
  AddType font/woff2 .woff2
</IfModule>

<IfModule mod_headers.c>
  # Required for SharedArrayBuffer (ffmpeg, sqlite, etc.).
  # public/mini-coi.js provides a service-worker fallback if these are missing,
  # but real headers skip the one-time reload.
  Header always set Cross-Origin-Opener-Policy "same-origin"
  Header always set Cross-Origin-Embedder-Policy "require-corp"
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "no-referrer"

  # Keep in sync with src/securityHeaders.cjs
  Header always set Content-Security-Policy "default-src 'none'; script-src 'self' 'unsafe-eval' blob:; style-src 'self' 'unsafe-inline' blob: data:; img-src 'self' blob: data:; media-src 'self' blob: data:; font-src 'self' blob: data:; connect-src 'self' blob: data:; worker-src 'self' blob:; manifest-src 'self'; frame-src 'self' blob: data:; object-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'; webrtc 'block'"

  # Hashed build assets never change
  <FilesMatch "^[^/]+\.(js|css|wasm|woff2|gz|mjs|sf2|sf3|data|txt|json)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  <Files "index.html">
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </Files>

  <Files "mini-coi.js">
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </Files>

  <Files "manifest.webmanifest">
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </Files>
</IfModule>

# The app is a single page with no client-side routes, so no SPA rewrite is
# needed. Leaving unknown paths as real 404s keeps cache.json detectable.
