{
  "id": "./",
  "name": "Convert2it — Universal File Converter",
  "short_name": "Convert2it",
  "description": "Convert 400+ file formats between any medium, entirely on-device. No uploads, no accounts, no servers.",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui"],
  "orientation": "any",
  "background_color": "#ffffff",
  "theme_color": "#1C77FF",
  "lang": "en",
  "dir": "ltr",
  "categories": ["productivity", "utilities"],
  "prefer_related_applications": false,
  "icons": [
    {
      "src": "icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icons/icon-maskable-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "icons/icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "share_target": {
    "action": "share-target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url",
      "files": [
        {
          "name": "files",
          "accept": [
            "image/*",
            "audio/*",
            "video/*",
            "text/*",
            "font/*",
            "application/*",
            "model/*"
          ]
        }
      ]
    }
  },
  "file_handlers": [
    {
      "action": "./?open-file",
      "accept": {
        "application/pdf": [".pdf"],
        "application/json": [".json"],
        "application/zip": [".zip"],
        "application/octet-stream": [".7z", ".rar", ".bson", ".bin"],
        "image/*": [".png", ".jpg", ".jpeg", ".gif", ".webp", ".svg", ".avif", ".ico", ".bmp"],
        "audio/*": [".mp3", ".wav", ".flac", ".ogg", ".m4a", ".aac", ".opus"],
        "video/*": [".mp4", ".webm", ".mkv", ".mov", ".avi", ".m4v"],
        "text/*": [".txt", ".md", ".csv", ".html", ".xml", ".css", ".js"],
        "font/*": [".ttf", ".otf", ".woff", ".woff2"]
      }
    }
  ]
}
